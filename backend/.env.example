# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=your-db-connection

# JWT & Internal Auth
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
INTERNAL_AUTH_SECRET=your-internal-server-to-server-secret
OAUTH_TOKEN_ENCRYPTION_KEY=your-fernet-base64-32-byte-key

# CORS
FRONTEND_URL=http://localhost:3000

# Google Gemini
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-pro,gemini-2.0-flash,gemini-1.5-pro

# File Storage
UPLOAD_DIR=uploads
GENERATED_DIR=generated
MAX_UPLOAD_SIZE_MB=10
